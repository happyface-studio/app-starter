# Copy to .env.local for local runs. On LiveKit Cloud, set these with `lk agent update-secrets`.

# LiveKit project (LiveKit Cloud → Settings → Keys). LiveKit Inference uses the same keys,
# so no separate STT / LLM / TTS provider keys are needed.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase (service role: the agent writes call status + transcripts, bypassing RLS)
SUPABASE_URL=https://your-dev-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: push notifications to the desk owner (OneSignal → Settings → Keys & IDs)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Optional model overrides (LiveKit Inference model strings)
# DESKMATES_LLM=openai/gpt-4.1-mini
# DESKMATES_STT=deepgram/nova-3
# DESKMATES_TTS=cartesia/sonic-3
